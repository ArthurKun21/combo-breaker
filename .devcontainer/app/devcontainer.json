{
  "name": "Java + Android",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installGradle": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "oderwat.indent-rainbow",
        "redhat.vscode-yaml",
        "-vscjava.vscode-java-pack",
        "-dbaeumer.vscode-eslint"
      ],
      "settings": {
        "chat.editor.fontSize": 15,
        "chat.fontSize": 14,
        "terminal.integrated.fontSize": 19,
        "editor.fontSize": 18
      }
    }
  },
  "remoteUser": "vscode"
}
